PORT=5000

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sundesh?retryWrites=true&w=majority

# Long random string used to sign login tokens — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Long-lived on purpose: employees and the owner stay signed in until they
# explicitly log out, rather than getting bounced to the login page.
JWT_EXPIRES_IN=100y

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:4200,https://your-app.vercel.app

# Bootstrapping the first superadmin: POST /api/admin/auth/register works
# without a token ONLY while zero admin accounts exist (a fresh deploy).
# Once the first admin exists, that same endpoint requires a valid admin
# token — so an existing superadmin can add more, but nobody else can.
